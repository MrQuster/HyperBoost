<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VolumeBooster" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VolumeBooster.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080C16</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VolumeBooster</item>
    </style>
</resources>
